{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Kosakata N5",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "word", "kana", "romaji", "meaning", "theme", "level", "example"],
    "properties": {
      "id": { "type": "string", "pattern": "^v[0-9]{4}$" },
      "word": { "type": "string", "minLength": 1 },
      "kana": { "type": "string", "minLength": 1 },
      "romaji": { "type": "string", "pattern": "^[a-z' ]+$" },
      "meaning": { "type": "string", "minLength": 1 },
      "theme": { "type": "string", "pattern": "^[a-z-]+$" },
      "level": { "type": "string", "enum": ["N5"] },
      "example": {
        "type": "object",
        "additionalProperties": false,
        "required": ["jp", "id"],
        "properties": {
          "jp": { "type": "string", "minLength": 1 },
          "id": { "type": "string", "minLength": 1 }
        }
      },
      "reviewed": { "type": "boolean" }
    }
  }
}
