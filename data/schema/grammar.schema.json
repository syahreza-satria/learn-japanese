{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Tata bahasa N5",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "category", "pattern", "title", "explanation", "examples", "exercise"],
    "properties": {
      "id": { "type": "string", "pattern": "^g[0-9]{3}$" },
      "category": { "type": "string", "minLength": 1 },
      "pattern": { "type": "string", "minLength": 1 },
      "title": { "type": "string", "minLength": 1 },
      "explanation": { "type": "string", "minLength": 1 },
      "examples": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["jp", "id"],
          "properties": { "jp": { "type": "string", "minLength": 1 }, "id": { "type": "string", "minLength": 1 } }
        }
      },
      "exercise": {
        "type": "object",
        "additionalProperties": false,
        "required": ["prompt", "answer", "choices"],
        "properties": {
          "prompt": { "type": "string", "pattern": "___" },
          "answer": { "type": "string", "minLength": 1 },
          "choices": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
          "hint": { "type": "string" }
        }
      },
      "reviewed": { "type": "boolean" }
    }
  }
}
