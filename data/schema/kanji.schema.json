{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Kanji N5",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "char", "meaning", "onyomi", "kunyomi", "strokes", "examples"],
    "properties": {
      "id": { "type": "string", "pattern": "^j[0-9]{3}$" },
      "char": { "type": "string", "minLength": 1, "maxLength": 1 },
      "meaning": { "type": "string", "minLength": 1 },
      "onyomi": { "type": "array", "items": { "type": "string", "minLength": 1 } },
      "kunyomi": { "type": "array", "items": { "type": "string", "minLength": 1 } },
      "strokes": { "type": "integer" },
      "examples": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["word", "kana", "meaning"],
          "properties": {
            "word": { "type": "string", "minLength": 1 },
            "kana": { "type": "string", "minLength": 1 },
            "meaning": { "type": "string", "minLength": 1 }
          }
        }
      },
      "reviewed": { "type": "boolean" }
    }
  }
}
